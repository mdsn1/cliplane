ENVIRONMENT=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Upstash Redis
UPSTASH_REDIS_URL=redis://default:your-token@your-redis.upstash.io:6379
UPSTASH_REDIS_TOKEN=your-upstash-token

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID_MONTHLY=price_xxx
STRIPE_PRICE_ID_ANNUAL=price_xxx

# Resend (email)
RESEND_API_KEY=re_xxx
DMCA_AGENT_EMAIL=dmca@cliplane.com
ADMIN_EMAIL=admin@cliplane.com

# Rate limiting
RATE_LIMIT_FREE=10

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://cliplane.com

# Sentry (optional)
SENTRY_DSN=

# Site URL
SITE_URL=https://cliplane.com
