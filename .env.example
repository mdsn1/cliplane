# Copy to .env.local and fill in real values

# Backend API URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe (publishable key — safe to expose)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Site URL (used for canonical URLs and OG images)
NEXT_PUBLIC_SITE_URL=https://cliplane.com

# Resend (server-side only — do NOT prefix with NEXT_PUBLIC_)
RESEND_API_KEY=re_xxx

# Admin email for contact form notifications
CONTACT_EMAIL=contact@cliplane.com
